# Infrastructure — read by both docker-compose.yml and settings.py
# Point these at your DB/Redis instances (local or remote)
LOOM_DATABASE__HOST=localhost
LOOM_DATABASE__PORT=5434
LOOM_REDIS__HOST=localhost
LOOM_REDIS__PORT=6380

# API keys
LOOM_EMBEDDING__API_KEY=
LOOM_LLM__API_KEY=

# GitHub token for ingestion scraping (standard name, no LOOM_ prefix)
GITHUB_TOKEN=
